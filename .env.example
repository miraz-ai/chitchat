# ===================================================================
# ChitChat — Environment Variables Configuration
# ===================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file or sensitive secrets to version control.

# -------------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# JSON Web Token Secret (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production_32chars_min

# Allowed CORS Origins (comma-separated for multiple origins)
# Example: https://chitchat.app,https://admin.chitchat.app
CORS_ORIGIN=http://localhost:5173

# -------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------
# Supported drivers: sqlite (default, zero-setup), mysql
DB_TYPE=sqlite
DB_FILE=server/database.sqlite

# MySQL Configuration (Used when DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=chitchat_user
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DATABASE=chitchat_db
MYSQL_CONNECTION_LIMIT=10

# -------------------------------------------------------------------
# Client / Frontend Configuration (Vite)
# -------------------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the client-side code.
# Backend database credentials and JWT secrets will NEVER leak to the bundle.
VITE_API_URL=http://localhost:3000
